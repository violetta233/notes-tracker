<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Notes Tracker" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Notes Tracker">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <%= link_to "🌷 Трекер заметок", root_path, class: "site-logo" %>

        <nav class="site-nav">
          <% if current_user %>
            <%= link_to "Выйти", logout_path,
                data: { turbo_method: :delete },
                class: "nav-button" %>
          <% else %>
            <%= link_to "Войти", login_path, class: "nav-link" %>

            <%= link_to "Регистрация", register_path,
                class: "nav-button" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main>
      <%= yield %>
    </main>

    <!-- КАСТОМНОЕ ОКНО ПОДТВЕРЖДЕНИЯ -->
    <dialog id="confirm-dialog" class="custom-dialog">
      <div class="dialog-content">
        <h2 id="dialog-message">Вы уверены?</h2>
        <div class="dialog-actions">
          <button id="dialog-cancel" class="button button-secondary">Отмена</button>
          <button id="dialog-confirm" class="button">Удалить</button>
        </div>
      </div>
    </dialog>

    <!-- СКРИПТ ДЛЯ ОКНА -->
    <script>
      document.addEventListener("turbo:load", () => {
        const dialog = document.getElementById("confirm-dialog");
        const message = document.getElementById("dialog-message");
        const btnConfirm = document.getElementById("dialog-confirm");
        const btnCancel = document.getElementById("dialog-cancel");

        // Перехватываем отправку форм с data-turbo-confirm
        document.addEventListener("submit", (e) => {
          const confirmMessage = e.target.dataset.turboConfirm;
          if (confirmMessage) {
            e.preventDefault(); // Останавливаем отправку
            message.textContent = confirmMessage;
            dialog.showModal(); // Показываем окно

            // Если нажали "Удалить"
            btnConfirm.onclick = () => {
              dialog.close();
              e.target.submit(); // Отправляем форму
            };
          }
        });

        // Если нажали "Отмена" или кликнули мимо окна
        btnCancel.onclick = () => dialog.close();
        dialog.addEventListener("click", (e) => {
          const rect = dialog.getBoundingClientRect();
          if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) {
            dialog.close();
          }
        });
      });
    </script>
  </body>
</html>