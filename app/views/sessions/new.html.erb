<div class="auth-page">
  <div class="flower flower-one">✿</div>
  <div class="flower flower-two">❀</div>
  <div class="flower flower-three">✿</div>

  <div class="auth-card">
    <div class="auth-decoration">🌷</div>

    <h1>С возвращением ♡</h1>

    <p class="auth-subtitle">
      Войди в свой уютный мир заметок
    </p>

    <% if flash[:alert] %>
      <div class="auth-error">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: login_path, class: "auth-form" do |form| %>
      <div class="form-group">
        <%= form.label :email, "Email" %>
        <%= form.email_field :email,
          placeholder: "your@email.com",
          autocomplete: "email" %>
      </div>

      <div class="form-group">
        <%= form.label :password, "Пароль" %>
        <%= form.password_field :password,
          placeholder: "Введите пароль",
          autocomplete: "current-password" %>
      </div>

      <%= form.submit "Войти ♡", class: "auth-button" %>
    <% end %>

    <p class="auth-footer">
      Ещё нет аккаунта?
      <%= link_to "Зарегистрироваться", register_path %>
    </p>
  </div>
</div>