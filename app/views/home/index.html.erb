<div class="dashboard">

  <%# Приветственная зона %>
  <section class="dashboard-hero">
    <div class="hero-text">
      <p class="hero-eyebrow">Твоё уютное пространство</p>

      <% if current_user %>
        <h1>Добро пожаловать, <%= current_user.name %> ♡</h1>
      <% else %>
        <h1>Трекер заметок</h1>
      <% end %>

      <p class="hero-subtitle">
        Здесь живут твои мысли, идеи и планы.
      </p>
    </div>

    <% if current_user %>
      <div class="hero-actions">
        <%= link_to "+ Новая заметка", new_note_path, class: "button" %>
        <%= link_to "+ Новая привычка", new_habit_path, class: "button button-secondary" %>
      </div>
    <% end %>
  </section>

  <% if current_user %>
    <%# Статистика %>
    <section class="stats-grid">
      <div class="stat-card card">
        <div class="stat-value"><%= current_user.notes.count %></div>
        <div class="stat-label">заметок</div>
      </div>

      <div class="stat-card card">
        <div class="stat-value"><%= current_user.habits.count %></div>
        <div class="stat-label">привычек</div>
      </div>

      <div class="stat-card card">
        <div class="stat-value"><%= current_user.notes.where(tag: "Идеи").count %></div>
        <div class="stat-label">идей</div>
      </div>
    </section>

    <%# Последние заметки %>
    <section class="notes-section">
      <div class="section-header">
        <h2>Последние заметки</h2>
        <%= link_to "Все заметки →", notes_path, class: "section-link" %>
      </div>

      <% if @notes && @notes.any? %>
        <div class="notes-grid">
          <% @notes.each do |note| %>
            <div class="note-card card" style="display: flex; flex-direction: column; gap: 10px; padding: 20px;">
              
              <!-- Шапка с датой и кнопками -->
              <div class="note-card-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border); padding-bottom: 10px; margin-bottom: 10px;">
                <span class="note-date" style="color: #b09c9f; font-size: 13px;"><%= note.created_at.strftime("%d.%m.%Y") %></span>
                
                <div style="display: flex; gap: 6px; align-items: center;">
                  <!-- Кнопка Редактировать -->
                  <%= link_to "✏️", edit_note_path(note), class: "button button-secondary", style: "padding: 4px 8px; font-size: 12px; text-decoration: none;" %>

                  <!-- Кнопка Поделиться -->
                  <button type="button" class="button share-btn" 
                          data-url="<%= public_note_url(note.share_token) %>" 
                          data-title="<%= note.title %>"
                          style="padding: 4px 10px; font-size: 12px; border: none; cursor: pointer;">
                    Поделиться
                  </button>

                   <!-- Кнопка удалить -->
                  <%= button_to "🗑", note_path(note), method: :delete, class: "delete-btn", form: { data: { turbo_confirm: "Удалить заметку?" }, style: "display: inline;" }, style: "background: none; border: none; cursor: pointer; font-size: 16px;" %>
                </div>
              </div>

              <!-- Пометка, если заметка скопирована -->
              <% if note.source_note_id.present? && note.source_note %>
                <div style="font-size: 11px; color: var(--color-primary-dark); font-weight: bold; margin-bottom: -5px;">
                  Совместно с: <%= note.source_note.user.name %>
                </div>
              <% end %>

              <h3 class="note-title" style="margin: 0;"><%= note.title %></h3>
              <p class="note-excerpt-full" style="margin: 0; color: var(--color-text-soft); white-space: pre-line;"><%= note.body %></p>
              
              <div class="note-tag" style="margin-top: auto; align-self: flex-start; background: #f8edef; color: #9b777e; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                <%= note.tag.presence || "Без тега" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty-notes card" style="padding: 40px;">
          <p style="margin: 0; color: var(--color-text-soft);">У тебя пока нет заметок. Создай первую!</p>
        </div>
      <% end %>
    </section>

    <%# Последние привычки %>
    <section class="notes-section" style="margin-top: 48px;">
      <div class="section-header">
        <h2>Мои привычки</h2>
        <%= link_to "Все привычки →", habits_path, class: "section-link" %>
      </div>

      <% if @habits && @habits.any? %>
        <div class="notes-grid">
          <% @habits.each do |habit| %>
            <details class="note-card card expandable-card">
              <summary class="note-summary">
                <div class="note-card-header">
                  <span class="note-icon">🌱</span>
                  <span class="note-date"><%= habit.frequency.presence || "Каждый день" %></span>
                </div>
                <h3 class="note-title"><%= habit.name %></h3>
              </summary>
              
              <div class="note-expanded-content">
                <p class="note-excerpt-full"><%= habit.description.presence || "Описание пока не добавлено." %></p>
                <div class="note-card-footer" style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px;">
                  <span class="note-tag">Привычка</span>
                  <div style="display: flex; gap: 10px; align-items: center;">
                    <%= button_to "🗑", habit_path(habit), method: :delete, class: "delete-btn", form: { data: { turbo_confirm: "Удалить привычку?" } } %>
                  </div>
                </div>
              </div>
            </details>
          <% end %>
        </div>
      <% else %>
        <div class="empty-notes card" style="padding: 40px;">
          <p style="margin: 0; color: var(--color-text-soft);">У тебя пока нет привычек. Начни с одной!</p>
        </div>
      <% end %>
    </section>

  <% else %>
    <%# Пустое состояние — неавторизованный пользователь %>
    <section class="empty-notes card">
      <div class="empty-flower">🌷</div>
      <h2>Добро пожаловать в Трекер!</h2>
      <p>
        Войди или создай аккаунт, чтобы начать
        сохранять свои мысли в одном уютном месте.
      </p>
    </section>
  <% end %>

</div>