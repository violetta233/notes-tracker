<div class="dashboard">

  <%# Приветственная зона %>
  <section class="dashboard-hero">
    <div class="hero-text">
      <p class="hero-eyebrow">Твоё уютное пространство</p>

      <% if current_user %>
        <h1>Добро пожаловать, <%= current_user.name %> ♡</h1>
      <% else %>
        <h1>Трекер заметок</h1>
      <% end %>

      <p class="hero-subtitle">
        Здесь живут твои мысли, идеи и планы.
      </p>
    </div>

    <% if current_user %>
      <div class="hero-actions">
        <%= link_to "+ Новая заметка", new_note_path, class: "button" %>
        <%= link_to "+ Новая привычка", new_habit_path, class: "button button-secondary" %>
      </div>
    <% end %>
  </section>

  <% if current_user %>
    <%# Статистика %>
    <section class="stats-grid">
      <div class="stat-card card">
        <div class="stat-value"><%= current_user.notes.count %></div>
        <div class="stat-label">заметок</div>
      </div>

      <div class="stat-card card">
        <div class="stat-value"><%= current_user.habits.count %></div>
        <div class="stat-label">привычек</div>
      </div>

      <div class="stat-card card">
        <div class="stat-value"><%= current_user.notes.where(tag: "Идеи").count %></div>
        <div class="stat-label">идей</div>
      </div>
    </section>

    <%# Последние заметки %>
    <section class="notes-section">
      <div class="section-header">
        <h2>Последние заметки</h2>
        <%= link_to "Все заметки →", "#", class: "section-link" %>
      </div>

      <% if @notes && @notes.any? %>
        <div class="notes-grid">
          <% @notes.each do |note| %>
            <article class="note-card card">
              <div class="note-card-header">
                <span class="note-icon">✿</span>
                <span class="note-date"><%= note.created_at.strftime("%d.%m.%Y") %></span>
              </div>

              <h3 class="note-title"><%= note.title %></h3>

              <p class="note-excerpt">
                <%= truncate(note.body, length: 100) %>
              </p>

              <div class="note-card-footer" style="display: flex; justify-content: space-between; align-items: center;">
                <span class="note-tag"><%= note.tag.presence || "Без тега" %></span>
                <div style="display: flex; gap: 10px; align-items: center;">
                  <span class="note-flower">✿</span>
                  <%= button_to "🗑", note_path(note), method: :delete, class: "delete-btn", form: { data: { turbo_confirm: "Удалить заметку?" } } %>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="empty-notes card" style="padding: 40px;">
          <p style="margin: 0; color: var(--color-text-soft);">У тебя пока нет заметок. Создай первую!</p>
        </div>
      <% end %>
    </section>

    <%# Последние привычки %>
    <section class="notes-section" style="margin-top: 48px;">
      <div class="section-header">
        <h2>Мои привычки</h2>
        <%= link_to "Все привычки →", "#", class: "section-link" %>
      </div>

      <% if @habits && @habits.any? %>
        <div class="notes-grid">
          <% @habits.each do |habit| %>
            <article class="note-card card">
              <div class="note-card-header">
                <span class="note-icon">🌱</span>
                <span class="note-date"><%= habit.frequency.presence || "Каждый день" %></span>
              </div>

              <h3 class="note-title"><%= habit.name %></h3>

              <p class="note-excerpt">
                <%= truncate(habit.description, length: 100) %>
              </p>

              <div class="note-card-footer" style="display: flex; justify-content: space-between; align-items: center;">
                <span class="note-tag">Привычка</span>
                <div style="display: flex; gap: 10px; align-items: center;">
                  <span class="note-flower">🌱</span>
                  <%= button_to "🗑", habit_path(habit), method: :delete, class: "delete-btn", form: { data: { turbo_confirm: "Удалить привычку?" } } %>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="empty-notes card" style="padding: 40px;">
          <p style="margin: 0; color: var(--color-text-soft);">У тебя пока нет привычек. Начни с одной!</p>
        </div>
      <% end %>
    </section>

  <% else %>
    <%# Пустое состояние — неавторизованный пользователь %>
    <section class="empty-notes card">
      <div class="empty-flower">🌷</div>
      <h2>Добро пожаловать в Трекер!</h2>
      <p>
        Войди или создай аккаунт, чтобы начать
        сохранять свои мысли в одном уютном месте.
      </p>
    </section>
  <% end %>

</div>