<div class="dashboard">

  <%# Приветственная зона %>
  <section class="dashboard-hero">
    <div class="hero-text">
      <p class="hero-eyebrow">Твоё уютное пространство</p>

      <% if current_user %>
        <h1>Добро пожаловать, <%= current_user.name %> ♡</h1>
      <% else %>
        <h1>Трекер заметок</h1>
      <% end %>

      <p class="hero-subtitle">
        Здесь живут твои мысли, идеи и планы.
      </p>
    </div>

    <% if current_user %>
     <div class="hero-actions">
      <%= link_to "+ Новая заметка", new_note_path, class: "button" %>
      <%= link_to "+ Новая привычка", new_habit_path, class: "button button-secondary" %>
    </div>
    <% end %>
  </section>

  <% if current_user %>
    <%# Статистика %>
    <section class="stats-grid">
      <div class="stat-card card">
        <div class="stat-value">12</div>
        <div class="stat-label">заметок</div>
      </div>

      <div class="stat-card card">
        <div class="stat-value">5</div>
        <div class="stat-label">личных</div>
      </div>

      <div class="stat-card card">
        <div class="stat-value">3</div>
        <div class="stat-label">идей</div>
      </div>
    </section>

    <%# Последние заметки %>
    <section class="notes-section">
      <div class="section-header">
        <h2>Последние заметки</h2>
        <%= link_to "Все заметки →", "#", class: "section-link" %>
      </div>

      <div class="notes-grid">
        <article class="note-card card">
          <div class="note-card-header">
            <span class="note-icon">✿</span>
            <span class="note-date">Сегодня</span>
          </div>

          <h3 class="note-title">Идеи для проекта</h3>

          <p class="note-excerpt">
            Нужно добавить сортировку по дате
            и красивый фильтр по тегам...
          </p>

          <div class="note-card-footer">
            <span class="note-tag">Проект</span>
            <span class="note-flower">✿</span>
          </div>
        </article>

        <article class="note-card card">
          <div class="note-card-header">
            <span class="note-icon">♡</span>
            <span class="note-date">Вчера</span>
          </div>

          <h3 class="note-title">Личные планы</h3>

          <p class="note-excerpt">
            Не забыть записаться на курсы
            и купить билеты на выходные...
          </p>

          <div class="note-card-footer">
            <span class="note-tag">Личное</span>
            <span class="note-flower">✿</span>
          </div>
        </article>
      </div>
    </section>

  <% else %>
    <%# Пустое состояние — неавторизованный пользователь %>
    <section class="empty-notes card">
      <div class="empty-flower">🌷</div>
      <h2>У тебя пока нет заметок</h2>
      <p>
        Войди или создай аккаунт, чтобы начать
        сохранять свои мысли в одном уютном месте.
      </p>
    </section>
  <% end %>

</div>