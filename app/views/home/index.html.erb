<div class="home-page">
  <% if current_user %>
    <div class="welcome-card">
      <div class="welcome-flower">🌷</div>

      <h1>Трекер заметок</h1>

      <h2>Добро пожаловать, <%= current_user.name %> ♡</h2>

      <p>
        Ты успешно вошла в свой аккаунт.
      </p>

      <p class="home-description">
        Здесь скоро появятся твои заметки,
        идеи и маленькие важные мысли.
      </p>

      <%= link_to "Выйти", logout_path,
          data: { turbo_method: :delete },
          class: "logout-button" %>
    </div>
  <% else %>
    <div class="welcome-card">
      <div class="welcome-flower">🌸</div>

      <h1>Трекер заметок</h1>

      <h2>Твои мысли заслуживают места ♡</h2>

      <p>
        Сохраняй идеи, планы и всё,
        что хочется запомнить.
      </p>

      <div class="home-actions">
        <%= link_to "Войти", login_path, class: "home-button" %>
        <%= link_to "Зарегистрироваться", register_path,
            class: "home-button secondary" %>
      </div>
    </div>
  <% end %>
</div>
