<div class="auth-page">
  <div class="flower flower-one">✿</div>
  <div class="flower flower-two">❀</div>
  <div class="flower flower-three">✿</div>

  <div class="auth-card card">
    <div class="auth-decoration">🌸</div>

    <h1>Создай свой аккаунт ♡</h1>

    <p class="auth-subtitle">
      Начни сохранять свои мысли и идеи
    </p>

    <% if @user.errors.any? %>
      <div class="error-message">
        <strong>Проверь введённые данные:</strong>

        <ul class="error-list">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: register_path, class: "auth-form" do |form| %>
      <div class="form-field">
        <%= form.label :name, "Имя" %>

        <%= form.text_field :name,
            placeholder: "Твоё имя",
            autocomplete: "name" %>
      </div>

      <div class="form-field">
        <%= form.label :email, "Email" %>

        <%= form.email_field :email,
            placeholder: "your@email.com",
            autocomplete: "email" %>
      </div>

      <div class="form-field">
        <%= form.label :password, "Пароль" %>

        <%= form.password_field :password,
            placeholder: "Придумай пароль",
            autocomplete: "new-password" %>
      </div>

      <div class="form-field">
        <%= form.label :password_confirmation, "Повторите пароль" %>

        <%= form.password_field :password_confirmation,
            placeholder: "Повтори пароль",
            autocomplete: "new-password" %>
      </div>

      <%= form.submit "Зарегистрироваться ♡",
          class: "button auth-submit-button" %>
    <% end %>

    <p class="auth-footer">
      Уже есть аккаунт?
      <%= link_to "Войти", login_path %>
    </p>
  </div>
</div>